+            ex_qty = _qty_num(existing.get("quantity")) or 0.0
+            new_qty = _qty_num(m.get("quantity")) or 0.0
+            if ex_qty == new_qty and _num_any(existing.get("locked")) == _num_any(m.get("locked")):
