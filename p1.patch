+      {text: fmtMoneyPlain(c.dividends + c.coupons)},
+      {text: fmtMoneySigned(c.unrealized_pl), cls: signClass(c.unrealized_pl)},
+      {text: fmtMoneyPlain(c.commissions + c.taxes)},
+      {text: fmtMoneySigned(c.total_pnl), cls: signClass(c.total_pnl)}
+    ]);
+    html += detailsHtml("Результат по классам активов", true,
+      table(["Класс активов", "Стоимость", "Реализ. P/L", "Див. и купоны", "Курсовая переоценка", "Комиссии и налоги", "Итого P/L"],
+        rows, ["","num","num","num","num","num","num"]).outerHTML);
+  }
+
+  if (data.cash_flow) {
+    const cf = data.cash_flow;
+    const rows = [
+      [{text: "Пополнение счёта"}, {text: fmtMoneyPlain(cf.pay_in), cls: "pos"}],
+      [{text: "Вывод средств"}, {text: fmtMoneyPlain(cf.pay_out), cls: "neg"}],
+      [{text: "Чистый приток / отток"}, {text: fmtMoneySigned(cf.net_flow), cls: signClass(cf.net_flow)}]
+    ];
+    html += detailsHtml("Справочно: Движение денежных средств", false, table(["Операция", "Сумма ₽"], rows, ["", "num"]).outerHTML);
+  }
+
+  body.innerHTML = html + '<p class="foot">' + (data.mode === "demo" ? "демо-данные" : "боевой API") + "</p>";
+
+  sectionActions("pnl", [
+    {label:"JSON", fn: () => dlJson("pnl", data)},
+    {label:"CSV", fn: () => dlCsvPnl(data)},
+    {label:"Markdown", fn: () => dlMdPnl(data)},
+    {label:"Сырой JSON", fn: () => openRaw("operations", filterBody())}
+  ]);
+  ensureSection("pnl").scrollIntoView({behavior:"smooth", block:"start"});
+}
+
+function dlCsvPnl(data) {
+  const rows = [];
+  rows.push(["Чистая прибыль (Итоговый P&L)", data.summary.net_pnl]);
+  rows.push(["Реализованный результат", data.summary.net_realized_pnl]);
+  rows.push(["Потенциальная прибыль (курсовая)", data.summary.potential_capital_gain]);
+  rows.push(["Всего доходов", data.summary.total_income]);
+  rows.push(["Всего расходов", data.summary.total_expenses]);
+  rows.push([]);
+  rows.push(["Статьи доходов"]);
+  (data.income_items || []).forEach(i => rows.push([i.label, i.value]));
+  rows.push([]);
+  rows.push(["Потенциальный прирост стоимости"]);
+  (data.potential_items || []).forEach(i => rows.push([i.label, i.value]));
+  rows.push([]);
+  rows.push(["Статьи расходов"]);
+  (data.expense_items || []).forEach(i => rows.push([i.label, i.value]));
+
+  downloadFile("bcs-pnl-"+stamp()+".csv", blobCsv(["Показатель / Статья", "Сумма ₽"], rows), "text/csv;charset=utf-8");
+}
+
+function dlMdPnl(data) {
+  const s = data.summary;
+  let md = "# Отчёт о прибылях и убытках (P&L)\n\n" +
+    "- Фильтр: " + data.filter.description + "\n" +
+    "- **Чистая прибыль (Итоговый P&L)**: " + fmtMoneySigned(s.net_pnl) + "\n" +
+    "- **Реализованный финансовый результат**: " + fmtMoneySigned(s.net_realized_pnl) + "\n" +
+    "- **Потенциальная прибыль от прироста стоимости**: " + fmtMoneySigned(s.potential_capital_gain) + "\n" +
+    "- Всего доходов: " + fmtMoneyPlain(s.total_income) + "\n" +
+    "- Всего расходов: " + fmtMoneyPlain(s.total_expenses) + "\n\n" +
+    "## Доходы\n\n" +
+    mdTable(["Статья", "Сумма ₽"], (data.income_items || []).map(i => [i.label, fmtMoneyPlain(i.value)])) + "\n\n" +
+    "## Потенциальная прибыль от прироста курсовой стоимости\n\n" +
+    mdTable(["Статья", "Сумма ₽"], (data.potential_items || []).map(i => [i.label, fmtMoneySigned(i.value)])) + "\n\n" +
+    "## Расходы\n\n" +
+    mdTable(["Статья", "Сумма ₽"], (data.expense_items || []).map(i => [i.label, fmtMoneyPlain(i.value)])) + "\n";
+
+  downloadFile("bcs-pnl-"+stamp()+".md", md, "text/markdown;charset=utf-8");
+}
